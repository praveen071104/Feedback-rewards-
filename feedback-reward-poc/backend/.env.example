# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=ms_feedback_platform

# --- LLM backend toggle ---
# scripted: deterministic triage, no network, no SDK required (default for dev).
# copilot : real Copilot SDK (requires `pip install copilot` and `copilot login`).
# AI knobs (model, limits, timeouts) live in `policy.json`, not here.
LLM_BACKEND=scripted

# --- Reward tiers (GBP) ---
FEEDBACK_REWARD_LOW_GBP=2.00
FEEDBACK_REWARD_MID_GBP=3.50
FEEDBACK_REWARD_HIGH_GBP=5.00

# --- CORS / cookies ---
FEEDBACK_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FEEDBACK_SESSION_COOKIE=feedback_staff_session
FEEDBACK_COOKIE_SECURE=false
FEEDBACK_SESSION_TTL_HOURS=8
